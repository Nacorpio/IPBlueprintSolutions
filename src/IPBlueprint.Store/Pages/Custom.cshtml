@page
@model CustomModel
@inject IOptions<ShopOptions> Shop
@{
    var shop = Shop.Value;
    ViewData["Title"] = L["Custom orders"].Value;
    ViewData["Description"] = L["Get something 3D printed just for you in {0}. Send us an idea, a sketch or a model file. Free pickup in {0}.", shop.Town].Value;
}

<div class="layout-two">
    <div>
        <h1>@L["Custom orders"]</h1>
        <p>@L["Want something that isn't in the shop? Describe what you have in mind. A few sentences are enough. A sketch, a photo or a 3D model file (STL, 3MF, OBJ, STEP) makes it easier for us to quote."]</p>
        <p>@L["We'll reply by email with a price and an estimated delivery time, usually within a few days. If you want to go ahead, we'll send you a payment link from SumUp."]</p>

        <form method="post" enctype="multipart/form-data" class="panel">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="field-row">
                <div class="field">
                    <label asp-for="Input.Name"></label>
                    <input asp-for="Input.Name" autocomplete="name" />
                    <span asp-validation-for="Input.Name" class="field-validation-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>
            </div>
            <div class="field">
                <label asp-for="Input.Description"></label>
                <textarea asp-for="Input.Description" placeholder="@L["What should we print? Roughly how big, how many, and what is it for?"]"></textarea>
                <span asp-validation-for="Input.Description" class="field-validation-error"></span>
            </div>
            <div class="field-row">
                <div class="field">
                    <label asp-for="Input.PreferredColour"></label>
                    <input asp-for="Input.PreferredColour" />
                </div>
                <div class="field">
                    <label asp-for="Input.Budget"></label>
                    <input asp-for="Input.Budget" />
                </div>
            </div>
            @if (shop.OffersPickup)
            {
                <fieldset class="field radio-group">
                    <legend>@L["How do you want to get it?"]</legend>
                    <label class="check"><input type="radio" name="Input.Delivery" value="@DeliveryMethod.Shipping" checked="@(Model.Input.Delivery != DeliveryMethod.Pickup)" /> <span>@L["Send it to me"]</span></label>
                    <label class="check"><input type="radio" name="Input.Delivery" value="@DeliveryMethod.Pickup" checked="@(Model.Input.Delivery == DeliveryMethod.Pickup)" /> <span>@L["I'll pick it up in {0} (free)", shop.Town]</span></label>
                </fieldset>
            }
            <div class="field">
                <label asp-for="Attachment">@L["File (optional)"]</label>
                <input asp-for="Attachment" type="file" accept="@FileStore.AttachmentAcceptList" />
                <div class="hint">@L["Images, PDF or 3D models, up to 25 MB."]</div>
                <span asp-validation-for="Attachment" class="field-validation-error"></span>
            </div>
            @* Hidden from people; bots that fill in every field give themselves away. *@
            <div style="position:absolute;left:-10000px" aria-hidden="true">
                <label for="website">Website</label>
                <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <p class="muted small">@L["We use your details only to answer this request. See our"] <a asp-page="/Info/Privacy">@L["privacy policy"]</a>.</p>
            <button class="button" type="submit">@L["Send request"]</button>
        </form>
    </div>
    <aside class="panel">
        <h2>@L["Good to know"]</h2>
        <ul class="small">
            <li>@L["We print in PLA, PETG and ABS in many colours."]</li>
            <li>@L["Maximum single-piece size is about 25 × 25 × 25 cm. We can print bigger things in parts."]</li>
            <li>@L["Custom items are made to order, so they can't be returned unless they are faulty."]</li>
            @if (shop.OffersPickup)
            {
                <li>@L["Live near {0}? Pick it up from us for free.", shop.Town]</li>
            }
        </ul>
    </aside>
</div>
