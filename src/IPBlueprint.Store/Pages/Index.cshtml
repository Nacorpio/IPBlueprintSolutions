@page
@model IndexModel
@inject IOptions<ShopOptions> Shop
@{
    var description = L["3D printed items made by two friends in Sweden. We also print custom orders."].Value;
    ViewData["Title"] = L["Shop"].Value;
    ViewData["FullTitle"] = $"{Shop.Value.Name} · {L["3D prints made in Sweden"].Value}";
    ViewData["Description"] = description;
    ViewData["JsonLd"] = Seo.StoreJsonLd(SiteUrls.BaseUrl(Request, Shop.Value), Shop.Value, description);
}

<section class="hero">
    <h1>@L["3D prints from our own printers"]</h1>
    <p>@L["We print everything in the shop ourselves, here in Sweden. If you want something that isn't listed, we take custom orders too."]</p>
</section>

<partial name="_Catalog" model="Model.View" />

<section class="custom-cta">
    <div>
        <h2>@L["Looking for something else?"]</h2>
        <p>@L["Send us an idea, a sketch or a 3D model and we'll give you a price."]</p>
    </div>
    <a class="button" asp-page="/Custom">@L["Request a custom print"]</a>
</section>
