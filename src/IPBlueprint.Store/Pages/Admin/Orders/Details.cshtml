@page "{id:guid}"
@model DetailsModel
@{
    var o = Model.Order;
    ViewData["Title"] = $"Order {o.Reference}";
}
<p class="small"><a asp-page="Index">← All orders</a></p>
<div class="toolbar">
    <h1 style="margin:0">Order @o.Reference</h1>
    <span>
        <span class="badge @o.Status">@OrderStatusFlow.AdminLabel(o.Status, o.Delivery)</span>
        @if (o.IsPickup)
        {
            <span class="badge Pickup">Pickup</span>
        }
    </span>
</div>

<div class="layout-two">
    <div class="panel">
        <h2>Items</h2>
        <table class="table">
            <thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var l in o.Lines)
                {
                    <tr><td>@l.ProductName</td><td>@l.Quantity</td><td>@Money.Format(l.UnitPrice)</td><td>@Money.Format(l.LineTotal)</td></tr>
                }
                <tr><td colspan="3">@(o.IsPickup ? $"Pickup in {Model.Town}" : "Shipping")</td><td>@Money.Format(o.ShippingCost)</td></tr>
                <tr><td colspan="3"><strong>Total</strong></td><td><strong>@Money.Format(o.Total)</strong></td></tr>
            </tbody>
        </table>
        @if (!string.IsNullOrWhiteSpace(o.CustomerNote))
        {
            <h3 style="margin-top:20px">Note from customer</h3>
            <p class="description">@o.CustomerNote</p>
        }
    </div>
    <aside class="panel">
        @if (o.IsPickup)
        {
            <h2>Pickup in @Model.Town</h2>
            <p>@o.CustomerName</p>
            <p class="muted small">No address needed. When it's ready, mark it as ready for pickup: the customer gets an email asking which times suit them, and you reply with the address. Keep the address out of the site.</p>
        }
        else
        {
            <h2>Ship to</h2>
            <p>
                @o.CustomerName<br />@o.AddressLine1<br />
                @if (!string.IsNullOrWhiteSpace(o.AddressLine2)) { @o.AddressLine2<br /> }
                @o.PostalCode @o.City
            </p>
        }
        <p><a href="mailto:@o.Email">@o.Email</a>@if (!string.IsNullOrWhiteSpace(o.Phone)) { <br />@o.Phone }</p>
        <p class="small muted">
            Created @ShopTime.ToSwedish(o.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm")<br />
            @if (o.PaidAtUtc is { } paid) { <text>Paid @ShopTime.ToSwedish(paid).ToString("yyyy-MM-dd HH:mm")<br /></text> }
            @if (o.SumUpTransactionCode is not null) { <text>SumUp transaction @o.SumUpTransactionCode<br /></text> }
            @if (o.ShippedAtUtc is { } shipped) { <text>Shipped @ShopTime.ToSwedish(shipped).ToString("yyyy-MM-dd HH:mm")<br /></text> }
            @if (!string.IsNullOrWhiteSpace(o.TrackingNumber)) { <text>Tracking number @o.TrackingNumber</text> }
        </p>

        @foreach (var next in OrderStatusFlow.NextSteps(o.Status, o.Delivery))
        {
            switch (next)
            {
                case OrderStatus.InProduction:
                    <form method="post" asp-page-handler="Status" class="status-action">
                        <input type="hidden" name="to" value="@next" />
                        <label class="check small"><input type="checkbox" name="emailCustomer" value="true" checked /> <span>Email the customer</span></label>
                        <button class="button wide" type="submit">Mark as in production</button>
                    </form>
                    break;
                case OrderStatus.Shipped:
                    <form method="post" asp-page-handler="Status" class="status-action">
                        <input type="hidden" name="to" value="@next" />
                        <div class="field">
                            <label for="tracking">Tracking number (optional)</label>
                            <input id="tracking" name="trackingNumber" type="text" maxlength="100" />
                        </div>
                        <label class="check small"><input type="checkbox" name="emailCustomer" value="true" checked /> <span>Email the customer</span></label>
                        <button class="button wide" type="submit">Mark as shipped</button>
                    </form>
                    break;
                case OrderStatus.ReadyForPickup:
                    <form method="post" asp-page-handler="Status" class="status-action">
                        <input type="hidden" name="to" value="@next" />
                        <label class="check small"><input type="checkbox" name="emailCustomer" value="true" checked /> <span>Email the customer to agree on a time</span></label>
                        <button class="button wide" type="submit">Mark as ready for pickup</button>
                    </form>
                    break;
                case OrderStatus.Delivered:
                    <form method="post" asp-page-handler="Status" class="status-action">
                        <input type="hidden" name="to" value="@next" />
                        <label class="check small"><input type="checkbox" name="emailCustomer" value="true" checked /> <span>Email the customer</span></label>
                        <button class="button wide" type="submit">@(o.IsPickup ? "Mark as picked up" : "Mark as delivered")</button>
                    </form>
                    break;
                case OrderStatus.Refunded:
                    <details class="status-action">
                        <summary>Cancel and refund…</summary>
                        <form method="post" asp-page-handler="Status" onsubmit="return confirm('Mark this order as refunded? Make the refund in the SumUp dashboard first.')">
                            <input type="hidden" name="to" value="@next" />
                            <p class="muted small">Make the refund in the SumUp dashboard first. This only updates the order and tells the customer.</p>
                            @if (Model.HasStockedItems && !o.StockRestored)
                            {
                                <label class="check small"><input type="checkbox" name="restock" value="true" checked="@(o.Status is OrderStatus.Paid or OrderStatus.InProduction or OrderStatus.ReadyForPickup)" /> <span>Put the items back in stock</span></label>
                            }
                            <label class="check small"><input type="checkbox" name="emailCustomer" value="true" checked /> <span>Email the customer</span></label>
                            <button class="button danger wide" type="submit">Mark as refunded</button>
                        </form>
                    </details>
                    break;
                case OrderStatus.Cancelled:
                    <form method="post" asp-page-handler="Status" class="status-action" onsubmit="return confirm('Cancel this unpaid order?')">
                        <input type="hidden" name="to" value="@next" />
                        <button class="button secondary wide" type="submit">Cancel unpaid order</button>
                    </form>
                    break;
            }
        }

        @if (o.History.Count > 0)
        {
            <h3 style="margin-top:20px">History</h3>
            <ul class="history small">
                @foreach (var h in o.History)
                {
                    <li>@ShopTime.ToSwedish(h.AtUtc).ToString("yyyy-MM-dd HH:mm") · @OrderStatusFlow.AdminLabel(h.Status, o.Delivery)@(h.CustomerEmailed ? " · customer emailed" : "")</li>
                }
            </ul>
        }

        @if (Model.StatusUrl is { } statusUrl && OrderStatusFlow.PaidStatuses.Contains(o.Status))
        {
            <p class="muted small" style="margin-top:16px">Customer's order page (sent in every email):<br /><a href="@statusUrl" style="word-break:break-all">@statusUrl</a></p>
        }
    </aside>
</div>
