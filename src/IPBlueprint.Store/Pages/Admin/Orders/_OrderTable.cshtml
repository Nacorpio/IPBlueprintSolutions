@model List<Order>
@if (Model.Count == 0)
{
    <p class="muted">No orders yet.</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><a asp-page="/Admin/Orders/Details" asp-route-id="@o.Id">@o.Reference</a></td>
                        <td>@ShopTime.ToSwedish(o.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@o.CustomerName<br /><span class="muted small">@o.Email</span></td>
                        <td>@Money.Format(o.Total)</td>
                        <td><span class="badge @o.Status">@OrderStatusFlow.AdminLabel(o.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
