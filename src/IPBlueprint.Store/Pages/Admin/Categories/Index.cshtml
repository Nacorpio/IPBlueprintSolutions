@page
@model IndexModel
@{ ViewData["Title"] = "Categories"; }
<div class="toolbar">
    <h1 style="margin:0">Categories</h1>
    <a class="button" asp-page="Edit">Add category</a>
</div>
<p class="muted">Categories show up as tabs in the shop, and each one gets its own page (good for Google). A product can be in several. Categories with no visible products are hidden from the shop.</p>
@if (Model.Categories.Count == 0)
{
    <p class="muted">No categories yet. Ideas: Figurer, Hem &amp; inredning, Reservdelar.</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Name</th><th>English</th><th>Products</th><th>Order</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td><a asp-page="Edit" asp-route-id="@c.Category.Id">@c.Category.Name</a><br /><span class="muted small">/categories/@c.Category.Slug</span></td>
                        <td>@(c.Category.NameEn ?? "–")</td>
                        <td>@c.ProductCount</td>
                        <td>@c.Category.SortOrder</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
