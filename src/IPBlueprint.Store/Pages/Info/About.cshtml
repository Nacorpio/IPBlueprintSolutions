@page
@inject IOptions<ShopOptions> Shop
@{ ViewData["Title"] = "About us"; }
<div class="prose">
    <h1>About us</h1>
    <p>We're two friends in Sweden who 3D print. We design or choose everything in the shop and print it on our own printers.</p>
    <p>Want us to make something? <a asp-page="/Custom">Send us a custom request</a> or email <a href="mailto:@Shop.Value.ContactEmail">@Shop.Value.ContactEmail</a>.</p>
</div>
