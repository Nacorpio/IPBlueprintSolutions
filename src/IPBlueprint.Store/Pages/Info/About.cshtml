@page
@inject IOptions<ShopOptions> Shop
@{ ViewData["Title"] = "About us"; }
<div class="prose">
    <h1>About us</h1>
    <p>We're two friends in Sweden who love 3D printing. Everything in the shop is designed or picked by us and printed on our own printers, one layer at a time.</p>
    <p>Have an idea for something we should make? <a asp-page="/Custom">Send us a custom request</a> or email <a href="mailto:@Shop.Value.ContactEmail">@Shop.Value.ContactEmail</a>.</p>
</div>
