@page
@model CheckoutModel
@{
    ViewData["Title"] = L["Checkout"].Value;
    ViewData["NoIndex"] = true;
    var shop = Model.Shop;
    var pickup = shop.OffersPickup && Model.Input.Delivery == DeliveryMethod.Pickup;
    var shippingCost = Model.ForDelivery(DeliveryMethod.Shipping).Shipping;
}

<h1>@L["Checkout"]</h1>

<partial name="_CartAdjustments" model="Model.Summary.Adjustments" />

@if (Model.ErrorMessage is not null)
{
    <div class="error-box">@Model.ErrorMessage</div>
}

<div class="layout-two">
    <form method="post" class="panel">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        @if (shop.OffersPickup)
        {
            <fieldset class="delivery-choice">
                <legend>@L["How do you want to get your order?"]</legend>
                <label class="delivery-option">
                    <input type="radio" name="Input.Delivery" value="@DeliveryMethod.Shipping" checked="@(!pickup)" />
                    <span class="option-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3z" /><path d="M14 9h4l3 3.5V16h-7z" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17.5" cy="17.5" r="1.8" /></svg></span>
                    <span>
                        <strong>@L["Send it to me"]</strong>
                        <span class="option-price">@(shippingCost == 0 ? L["Free"].Value : Money.Format(shippingCost))</span>
                        <span class="hint">@L["Posted to your address in Sweden."]</span>
                    </span>
                </label>
                <label class="delivery-option">
                    <input type="radio" name="Input.Delivery" value="@DeliveryMethod.Pickup" checked="@pickup" />
                    <span class="option-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg></span>
                    <span>
                        <strong>@L["Pick up in {0}", shop.Town]</strong>
                        <span class="option-price free">@L["Free"]</span>
                        <span class="hint">@L["No address needed. When your order is ready, we'll contact you to agree on a time."]</span>
                    </span>
                </label>
            </fieldset>
        }

        <h2>@L["Your details"]</h2>
        <div class="field">
            <label asp-for="Input.Name"></label>
            <input asp-for="Input.Name" autocomplete="name" />
            <span asp-validation-for="Input.Name" class="field-validation-error"></span>
        </div>
        <div class="field-row">
            <div class="field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Phone"></label>
                <input asp-for="Input.Phone" autocomplete="tel" />
                <div class="hint">@L["Optional. Lets us or the courier reach you."]</div>
            </div>
        </div>
        <div id="address-fields" hidden="@pickup">
        <h2>@L["Delivery address"]</h2>
        <div class="field">
            <label asp-for="Input.AddressLine1"></label>
            <input asp-for="Input.AddressLine1" autocomplete="address-line1" />
            <span asp-validation-for="Input.AddressLine1" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.AddressLine2"></label>
            <input asp-for="Input.AddressLine2" autocomplete="address-line2" />
        </div>
        <div class="field-row">
            <div class="field">
                <label asp-for="Input.PostalCode"></label>
                <input asp-for="Input.PostalCode" autocomplete="postal-code" inputmode="numeric" />
                <span asp-validation-for="Input.PostalCode" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.City"></label>
                <input asp-for="Input.City" autocomplete="address-level2" />
                <span asp-validation-for="Input.City" class="field-validation-error"></span>
            </div>
        </div>
        <p class="muted small">@L["We currently ship within Sweden only."]</p>
        </div>
        <div class="field">
            <label asp-for="Input.Note"></label>
            <textarea asp-for="Input.Note" style="min-height:80px"></textarea>
        </div>
        <div class="field">
            <label class="check">
                <input asp-for="Input.AcceptTerms" />
                <span>@L["I have read and accept"] <a asp-page="/Info/Terms" target="_blank">@L["the terms of purchase"]</a> @L["and"] <a asp-page="/Info/Privacy" target="_blank">@L["the privacy policy"]</a>.</span>
            </label>
            <span asp-validation-for="Input.AcceptTerms" class="field-validation-error"></span>
        </div>

        <button class="button wide" type="submit">@L["Continue to payment"]</button>
        <p class="muted small">@L["You'll pay on SumUp's secure payment page. We never see your card details."]</p>
    </form>

    <aside class="panel">
        <h2>@L["Your order"]</h2>
        @foreach (var line in Model.Summary.Lines)
        {
            <div class="small" style="display:flex;justify-content:space-between;gap:8px;margin-bottom:6px">
                <span>@line.Quantity × @line.Product.DisplayName</span><span>@Money.Format(line.LineTotal)</span>
            </div>
        }
        <hr style="border:0;border-top:1px solid var(--border)" />
        @if (shop.OffersPickup)
        {
            <div data-totals="@DeliveryMethod.Shipping" hidden="@pickup"><partial name="_Totals" model="Model.ForDelivery(DeliveryMethod.Shipping)" /></div>
            <div data-totals="@DeliveryMethod.Pickup" hidden="@(!pickup)"><partial name="_Totals" model="Model.ForDelivery(DeliveryMethod.Pickup)" /></div>
        }
        else
        {
            <partial name="_Totals" model="Model.Summary" />
        }
        <a asp-page="/Cart" class="small">@L["Edit cart"]</a>
    </aside>
</div>

@section Scripts {
    <script>
        // Pickup needs no address: hide those fields and show the total without shipping. Without JavaScript both
        // stay visible and the server simply ignores the address for pickup orders.
        (function () {
            var radios = document.querySelectorAll('input[name="Input.Delivery"]');
            if (!radios.length) return;
            var address = document.getElementById("address-fields");
            function update() {
                var chosen = document.querySelector('input[name="Input.Delivery"]:checked');
                var value = chosen ? chosen.value : "Shipping";
                address.hidden = value === "Pickup";
                document.querySelectorAll("[data-totals]").forEach(function (el) { el.hidden = el.dataset.totals !== value; });
            }
            radios.forEach(function (r) { r.addEventListener("change", update); });
            update();
        })();
    </script>
}
