@page
@model ErrorModel
@{
    ViewData["Title"] = Model.IsNotFound ? L["Page not found"].Value
        : Model.IsTooManyRequests ? L["Too many attempts"].Value
        : L["Something went wrong"].Value;
    ViewData["NoIndex"] = true;
}
<div class="prose">
    @if (Model.IsNotFound)
    {
        <h1>@L["We couldn't find that page"]</h1>
        <p>@L["It may have moved or no longer exist."]</p>
    }
    else if (Model.IsTooManyRequests)
    {
        <h1>@L["Too many attempts"]</h1>
        <p>@L["You've sent this form several times in a short while. Please wait a little and try again, or email us."]</p>
    }
    else
    {
        <h1>@L["Something went wrong"]</h1>
        <p>@L["Sorry about that. Please try again, or contact us if the problem continues."]</p>
        @if (Model.RequestId is not null)
        {
            <p class="muted small">@L["Reference:"] <code>@Model.RequestId</code></p>
        }
    }
    <a class="button" asp-page="/Index">@L["Back to the shop"]</a>
</div>
