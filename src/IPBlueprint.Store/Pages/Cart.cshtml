@page
@model CartModel
@{
    ViewData["Title"] = L["Your cart"].Value;
    ViewData["NoIndex"] = true;
    var shop = Model.Shop;
}

<h1>@L["Your cart"]</h1>

<partial name="_CartAdjustments" model="Model.Summary.Adjustments" />

@if (Model.Summary.IsEmpty)
{
    <p>@L["Your cart is empty."]</p>
    <a class="button" asp-page="/Index">@L["Browse the shop"]</a>
}
else
{
    <div class="layout-two">
        <div class="panel">
            @foreach (var line in Model.Summary.Lines)
            {
                <div class="cart-line">
                    <partial name="_ProductImage" model="line.Product" />
                    <div>
                        <a asp-page="/Product" asp-route-slug="@line.Product.Slug"><strong>@line.Product.DisplayName</strong></a>
                        <div class="muted small">@L["{0} each", Money.Format(line.Product.Price)]</div>
                        <partial name="_StockBadge" model="line.Product" />
                        <form method="post" asp-page-handler="Update" class="qty">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <label class="small" for="q-@line.Product.Id" style="margin:0">@L["Qty"]</label>
                            <input id="q-@line.Product.Id" name="quantity" type="number" min="0" max="@line.Product.AvailableToBuy(shop.MaxQuantityPerItem)" value="@line.Quantity" />
                            <button class="link-button small" type="submit">@L["Update"]</button>
                            <button class="link-button small" type="submit" name="quantity" value="0">@L["Remove"]</button>
                        </form>
                    </div>
                    <div class="price">@Money.Format(line.LineTotal)</div>
                </div>
            }
        </div>

        <aside class="panel">
            <partial name="_Totals" model="Model.Summary" />
            @if (Model.Summary.Shipping > 0 && shop.FreeShippingFrom > 0)
            {
                <p class="muted small">@L["Free shipping on orders from {0}.", Money.Format(shop.FreeShippingFrom)]</p>
            }
            @if (shop.OffersPickup)
            {
                <p class="pickup-note small">@L["Live near {0}? Pick up your order from us for free. Choose it at checkout.", shop.Town]</p>
            }
            <a class="button wide" asp-page="/Checkout">@L["Go to checkout"]</a>
        </aside>
    </div>
}
