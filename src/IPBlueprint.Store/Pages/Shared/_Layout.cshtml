@inject CartService Cart
@inject IOptions<ShopOptions> ShopOptions
@{
    var shop = ShopOptions.Value;
    var cartCount = Cart.CountItems();
    var isAdmin = Context.Request.Path.StartsWithSegments("/Admin") && User.Identity?.IsAuthenticated == true;

    // Search engines and link previews. Pages fill in Title, Description, and optionally FullTitle, Image (a site path),
    // OgType, JsonLd and NoIndex. See Shop/Seo.cs.
    var baseUrl = SiteUrls.BaseUrl(Context.Request, shop);
    var path = Seo.CanonicalPath(Context.Request);
    var canonical = Seo.PageUrl(baseUrl, path, Languages.Current);
    var isPrivatePage = path.StartsWith("/admin") || path.StartsWith("/order");
    var noIndex = ViewData["NoIndex"] is true || isPrivatePage;
    var title = ViewData["FullTitle"] as string ?? (ViewData["Title"] is string t ? $"{t} · {shop.Name}" : shop.Name);
    var description = ViewData["Description"] as string;
    var shareImage = new Uri(baseUrl, (ViewData["Image"] as string ?? Seo.DefaultShareImage).TrimStart('/')).AbsoluteUri;

    // Marks the main-nav link for the section the visitor is in (styled as an underline).
    string? Current(params string[] prefixes) =>
        prefixes.Any(p => p == "/" ? path == "/" : path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
}
<!DOCTYPE html>
<html lang="@Languages.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script>
        // Apply a saved theme choice before the page paints, to avoid a flash.
        try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) { }
    </script>
    <title>@title</title>
    @if (description is not null)
    {
        <meta name="description" content="@description" />
    }
    @if (noIndex)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@canonical" />
        @foreach (var (hreflang, url) in Seo.Alternates(baseUrl, path))
        {
            <link rel="alternate" hreflang="@hreflang" href="@url" />
        }
    }
    <meta property="og:site_name" content="@shop.Name" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:title" content="@(ViewData["FullTitle"] as string ?? ViewData["Title"] as string ?? shop.Name)" />
    @if (description is not null)
    {
        <meta property="og:description" content="@description" />
    }
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@shareImage" />
    @if (ViewData["Image"] is null)
    {
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="@shop.Name" />
    }
    <meta property="og:locale" content="@(Languages.IsEnglish ? "en_GB" : "sv_SE")" />
    <meta property="og:locale:alternate" content="@(Languages.IsEnglish ? "sv_SE" : "en_GB")" />
    @if (ViewData["PriceSek"] is decimal price)
    {
        <meta property="product:price:amount" content="@price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
        <meta property="product:price:currency" content="SEK" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    @if (ViewData["JsonLd"] is string jsonLd)
    {
        @* "!" keeps the script tag helper from re-encoding the type as "ld&#x2B;json". *@
        <!script type="application/ld+json">@Html.Raw(jsonLd)</!script>
    }
    @if (!isPrivatePage)
    {
        <partial name="_Analytics" />
    }
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="~/img/logo-mark.png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAdmin ? "is-admin" : null)">
    @if (shop.OffersPickup && !isAdmin)
    {
        <div class="perk-bar">
            <div class="container">
                <a asp-page="/Info/About" asp-fragment="pickup">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                    <span>@L["Free pickup in {0}", shop.Town]</span>
                </a>
                @if (shop.FreeShippingFrom > 0)
                {
                    <span class="perk-sep" aria-hidden="true">·</span>
                    <span class="perk-secondary">@L["Free shipping from {0}", Money.Format(shop.FreeShippingFrom)]</span>
                }
            </div>
        </div>
    }
    <header class="site-header">
        <div class="container header-row">
            <a class="brand" asp-page="/Index">
                <img class="logo-dark" src="~/img/logo.png" asp-append-version="true" alt="@shop.Name" width="697" height="274" />
                <img class="logo-light" src="~/img/logo-light.png" asp-append-version="true" alt="@shop.Name" width="697" height="274" />
            </a>
            <nav class="main-nav" aria-label="@L["Main"]">
                <a asp-page="/Index" aria-current="@Current("/", "/categories", "/products")">@L["Shop"]</a>
                <a asp-page="/Gallery" aria-current="@Current("/gallery")">@L["Gallery"]</a>
                <a asp-page="/Custom" aria-current="@Current("/custom")">@L["Custom orders"]</a>
                <a asp-page="/Info/About" aria-current="@Current("/info/about")">@L["About"]</a>
                <a asp-page="/Cart" class="cart-link" aria-current="@Current("/cart", "/checkout")">@L["Cart"]@(cartCount > 0 ? $" ({cartCount})" : "")</a>
                @if (Languages.IsEnglish)
                {
                    <a class="lang-switch" href="@Seo.WithLanguage(Context.Request, Languages.Swedish)" lang="sv" hreflang="sv" title="Visa sidan på svenska">Svenska</a>
                }
                else
                {
                    <a class="lang-switch" href="@Seo.WithLanguage(Context.Request, Languages.English)" lang="en" hreflang="en" title="Show this page in English">English</a>
                }
                <button type="button" class="theme-toggle" id="theme-toggle" aria-label="@L["Switch between light and dark theme"]" title="@L["Light / dark theme"]">
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </nav>
        </div>
        @if (isAdmin)
        {
            <div class="admin-bar">
                <div class="container header-row">
                    <strong>Admin</strong>
                    <nav aria-label="Admin">
                        <a asp-page="/Admin/Index">Overview</a>
                        <a asp-page="/Admin/Orders/Index">Orders</a>
                        <a asp-page="/Admin/Products/Index">Products</a>
                        <a asp-page="/Admin/Categories/Index">Categories</a>
                        <a asp-page="/Admin/Gallery/Index">Gallery</a>
                        <a asp-page="/Admin/Requests/Index">Custom requests</a>
                        <form method="post" asp-page="/Admin/Logout" class="inline"><button class="link-button">Log out</button></form>
                    </nav>
                </div>
            </div>
        }
    </header>

    <main class="container page">
        @if (TempData["Flash"] is string flash)
        {
            <div class="flash" role="status">@flash</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-row">
            <div>
                <strong>@shop.Name</strong><br />
                @(string.IsNullOrWhiteSpace(shop.Town) ? L["3D printed in Sweden."] : L["3D printed in {0}, Sweden.", shop.Town])<br />
                @if (shop.OffersPickup)
                {
                    @L["Free pickup in {0}", shop.Town]<br />
                }
                <a href="mailto:@shop.ContactEmail">@shop.ContactEmail</a>
                <partial name="_SocialIcons" />
            </div>
            <nav aria-label="@L["Information"]">
                <a asp-page="/Info/Terms">@L["Terms of purchase"]</a>
                <a asp-page="/Info/Returns">@L["Returns & right of withdrawal"]</a>
                <a asp-page="/Info/Privacy">@L["Privacy policy"]</a>
                <a asp-page="/Info/About">@L["About us"]</a>
            </nav>
            <div class="muted small">@L["Prices include 25% VAT. Card payments are handled by SumUp."]</div>
        </div>
    </footer>

    <script>
        document.getElementById("theme-toggle").addEventListener("click", function () {
            var root = document.documentElement;
            var current = root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            var next = current === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            try { localStorage.setItem("theme", next); } catch (e) { }
        });

        // Blur the workshop photo behind the page as the visitor scrolls. Most browsers do this in
        // CSS (scroll-driven animations); this covers the rest. Off for reduced motion.
        if (!(window.CSS && CSS.supports("animation-timeline: scroll()")) && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            var root = document.documentElement, queued = false;
            var setBlur = function () {
                queued = false;
                root.style.setProperty("--backdrop-blur", Math.min(scrollY / (innerHeight * 0.6), 1).toFixed(3));
            };
            addEventListener("scroll", function () { if (!queued) { queued = true; requestAnimationFrame(setBlur); } }, { passive: true });
            setBlur();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
