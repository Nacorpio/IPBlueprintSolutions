@model CartSummary
<table class="totals">
    <tr><td>Subtotal</td><td>@Money.Format(Model.Subtotal)</td></tr>
    <tr><td>Shipping</td><td>@(Model.Shipping == 0 ? "Free" : Money.Format(Model.Shipping))</td></tr>
    <tr class="grand"><td>Total</td><td>@Money.Format(Model.Total)</td></tr>
</table>
<p class="muted small">Including VAT of @Money.Format(Math.Round(Model.Total * 0.2m, 2)).</p>
