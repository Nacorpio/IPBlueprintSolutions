@page "/order/{id:guid}"
@model OrderModel
@{
    var o = Model.Order;
    var lang = Languages.Current;
    ViewData["Title"] = L["Order {0}", o.Reference].Value;
    var town = Model.Town;

    string StepLabel(OrderStatus status) => status switch
    {
        OrderStatus.Paid => L["Paid"],
        OrderStatus.InProduction => L["Being printed"],
        OrderStatus.Shipped => L["Shipped"],
        OrderStatus.ReadyForPickup => L["Ready for pickup"],
        _ => o.IsPickup ? L["Picked up"] : L["Delivered"],
    };
}

@switch (o.Status)
{
    case OrderStatus.AwaitingPayment or OrderStatus.PaymentFailed when o.PaymentNeedsChecking:
        <h1>@L["We're checking your payment"]</h1>
        <p>@L["A payment for this order came in that we need to look at by hand. Please don't pay again: we'll email you as soon as we've sorted it out."]</p>
        break;
    case OrderStatus.Paid:
        <h1>@L["Thank you for your order!"]</h1>
        @if (o.IsPickup)
        {
            <p>@L["We've received your payment and sent a confirmation to"] <strong>@o.Email</strong>. @L["When your order is ready to pick up in {0}, we'll contact you to agree on a time.", town]</p>
        }
        else
        {
            <p>@L["We've received your payment and sent a confirmation to"] <strong>@o.Email</strong>. @L["We'll email you again when it ships."]</p>
        }
        break;
    case OrderStatus.InProduction:
        <h1>@L["We're printing your order"]</h1>
        <p>@(o.IsPickup ? L["Some prints take a while. We'll email you when it's ready to pick up."] : L["Some prints take a while. We'll email you when the parcel is on its way."])</p>
        break;
    case OrderStatus.ReadyForPickup:
        <h1>@L["Your order is ready to pick up"]</h1>
        <p>@L["You can pick it up from us in {0}. Reply to our email with the days and times that suit you, and we'll send you the address.", town]</p>
        break;
    case OrderStatus.Delivered when o.IsPickup:
        <h1>@L["Thanks for picking up your order"]</h1>
        <p>@L["We hope you like it! If something isn't right, just get in touch."]</p>
        break;
    case OrderStatus.Shipped:
        <h1>@L["Your order is on its way"]</h1>
        <p>@L["We've sent your parcel. If something is wrong when it arrives, just get in touch."]</p>
        break;
    case OrderStatus.Delivered:
        <h1>@L["Your order has been delivered"]</h1>
        <p>@L["We hope you like it! If something isn't right, just get in touch."]</p>
        break;
    case OrderStatus.Refunded:
        <h1>@L["This order has been refunded"]</h1>
        <p>@L["We've paid the money back. It usually takes a few working days to show up on your card."]</p>
        break;
    case OrderStatus.PaymentFailed:
        <h1>@L["The payment didn't go through"]</h1>
        <p>@L["No money has been taken. You can try again below, or contact us if the problem continues."]</p>
        <form method="post" asp-page-handler="Retry"><button class="button" type="submit">@L["Try paying again"]</button></form>
        break;
    case OrderStatus.Cancelled:
        <h1>@L["This order was cancelled"]</h1>
        <p>@L["Please contact us if you have questions."]</p>
        break;
    default:
        <h1>@L["We're waiting for the payment to be confirmed"]</h1>
        <p>@L["This usually takes a few seconds."] <a href="">@L["Refresh this page"]</a> @L["to check again."]</p>
        <form method="post" asp-page-handler="Retry"><button class="link-button" type="submit">@L["Didn't finish paying? Pay now"]</button></form>
        break;
}

@if (Model.Steps.Count > 0)
{
    <ol class="order-steps" aria-label="@L["Order status"]">
        @foreach (var step in Model.Steps)
        {
            <li class="@(step.Done ? "done" : "")@(step.Current ? " current" : "")" aria-current="@(step.Current ? "step" : null)">
                <span class="dot" aria-hidden="true"></span>
                <span class="label">@StepLabel(step.Status)</span>
                @if (step.AtUtc is { } at)
                {
                    <span class="muted small">@ShopTime.FormatDate(at, lang)</span>
                }
            </li>
        }
    </ol>
}

@if (!string.IsNullOrWhiteSpace(o.TrackingNumber) && o.Status is OrderStatus.Shipped or OrderStatus.Delivered)
{
    <p>@L["Tracking number:"] <strong>@o.TrackingNumber</strong></p>
}

<div class="panel" style="margin-top:24px;max-width:560px">
    <p>@L["Order number:"] <strong>@o.Reference</strong></p>
    @foreach (var line in o.Lines)
    {
        <div style="display:flex;justify-content:space-between;gap:8px"><span>@line.Quantity × @line.ProductName</span><span>@Money.Format(line.LineTotal)</span></div>
    }
    @if (o.IsPickup)
    {
        <div style="display:flex;justify-content:space-between;gap:8px"><span>@L["Pickup in {0}", town]</span><span>@L["Free"]</span></div>
    }
    else
    {
        <div style="display:flex;justify-content:space-between;gap:8px"><span>@L["Shipping"]</span><span>@(o.ShippingCost == 0 ? L["Free"].Value : Money.Format(o.ShippingCost))</span></div>
    }
    <div style="display:flex;justify-content:space-between;gap:8px;font-weight:700;margin-top:8px"><span>@L["Total"]</span><span>@Money.Format(o.Total)</span></div>
</div>

<p class="muted small" style="margin-top:16px">@L["Keep this link to check on your order. Anyone with the link can see this page, so don't share it."]</p>
<p style="margin-top:24px"><a asp-page="/Index">@L["Back to the shop"]</a></p>
